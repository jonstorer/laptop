#!/bin/sh

# Welcome to the ubuntu machine script!
# Headless Ubuntu 26.04 LTS dev box (amd64). Three jobs: a dev environment
# reached over SSH (vim + Claude Code CLI), a Node app deploy target (Docker,
# Postgres, Redis) for whatever gets deployed here, and, optionally, a GitHub
# Actions self-hosted runner. No desktop session.

# Ask for sudo upfront so we don't have to get it later
sudo -v

# Keep using sudo so the permissions don't time out
while true; do sudo -n true; sleep 10; kill -0 "$$" || exit; done 2>/dev/null &

# apt 3.x (Ubuntu 26.04) prompts "Continue? [Y/n]" even with -y when stdin is
# a pipe. DEBIAN_FRONTEND=noninteractive suppresses all interactive apt prompts.
export DEBIAN_FRONTEND=noninteractive

# Run logging -- append one tab-separated line per run to ~/.laptop/runs.log so
# it's easy to see which script ran on which host, when, for how long, against
# which repo commit, and whether it succeeded. The commit is fetched lazily at
# exit (via curl or wget) and falls back to "unknown" when offline or unset.
LAPTOP_SCRIPT="ubuntu"
LAPTOP_RUN_START=$(date +%s)

log_run() {
  _ret="$1"
  _dur=$(( $(date +%s) - LAPTOP_RUN_START ))
  if [ "$_ret" -eq 0 ]; then _outcome="ok"; else _outcome="fail"; fi
  _api="https://api.github.com/repos/jonstorer/laptop/commits/main"
  _commit=$( { curl -fsSL "$_api" 2>/dev/null || wget -qO- "$_api" 2>/dev/null; } \
    | grep -m1 '"sha"' | cut -d'"' -f4 | cut -c1-12)
  [ -n "$_commit" ] || _commit="unknown"
  mkdir -p "$HOME/.laptop"
  printf '%s\t%s\t%s\t%s\t%s\t%ss\texit=%s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
    "$LAPTOP_SCRIPT" "$(hostname)" "$_commit" \
    "$_outcome" "$_dur" "$_ret" >> "$HOME/.laptop/runs.log"
}

# shellcheck disable=SC2154
trap 'ret=$?; log_run "$ret"; test $ret -ne 0 && printf "failed\n\n" >&2; exit $ret' EXIT
set -e

# Wait for apt locks to be released
wait_for_apt() {
  echo "Waiting for apt lock..."
  while sudo fuser /var/lib/apt/lists/lock /var/lib/dpkg/lock-frontend >/dev/null 2>&1; do
    sleep 3
  done
}

###############################################################################
# System packages                                                             #
###############################################################################

wait_for_apt
sudo -E apt update
sudo -E apt full-upgrade -y

sudo -E apt install -y \
  build-essential \
  ca-certificates \
  curl \
  git \
  gnupg \
  htop \
  jq \
  pipx \
  python3-pip \
  ripgrep \
  tmux \
  trash-cli \
  vim \
  wget \
  yq \
  zsh

###############################################################################
# GitHub CLI -- official apt repository                                       #
###############################################################################

if ! command -v gh > /dev/null 2>&1; then
  echo "Installing GitHub CLI ..."
  sudo install -d -m 0755 /usr/share/keyrings
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | sudo tee /usr/share/keyrings/githubcli-archive-keyring.gpg > /dev/null
  sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
  wait_for_apt
  sudo -E apt update
  sudo -E apt install -y gh
else
  echo "GitHub CLI already installed, skipping."
fi

###############################################################################
# Node.js -- via mise, re-resolved to the latest LTS on every run            #
###############################################################################

export PATH="$HOME/.local/bin:$PATH"
if ! command -v mise > /dev/null 2>&1; then
  echo "Installing mise ..."
  curl -fsSL https://mise.run | sh
fi

echo "Setting up mise and Node.js ..."
mise use --global node@lts
echo "Node.js LTS set as global default via mise: $(mise exec node -- node -v 2>/dev/null || echo 'unable to verify')"

ZPROFILE="$HOME/.zprofile"
if ! grep -qF 'mise activate' "$ZPROFILE" 2>/dev/null; then
  # shellcheck disable=SC2016
  printf '\nexport PATH="$HOME/.local/bin:$PATH"\neval "$(mise activate zsh)"\n' >> "$ZPROFILE"
fi

###############################################################################
# Claude Code CLI -- via official apt repository                              #
###############################################################################

if ! command -v claude > /dev/null 2>&1; then
  echo "Installing Claude Code CLI ..."
  sudo install -d -m 0755 /etc/apt/keyrings
  sudo curl -fsSL https://downloads.claude.ai/keys/claude-code.asc \
    -o /etc/apt/keyrings/claude-code.asc
  echo "deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main" \
    | sudo tee /etc/apt/sources.list.d/claude-code.list > /dev/null
  wait_for_apt
  sudo -E apt update
  sudo -E apt install -y claude-code
else
  echo "Claude Code CLI already installed, skipping."
fi

###############################################################################
# Google Chrome -- headless browser automation for Claude Code               #
###############################################################################

if ! command -v google-chrome > /dev/null 2>&1; then
  echo "Installing Google Chrome ..."
  sudo install -d -m 0755 /etc/apt/keyrings
  curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
    | sudo gpg --dearmor --batch --yes -o /etc/apt/keyrings/google-chrome.gpg
  sudo chmod 644 /etc/apt/keyrings/google-chrome.gpg
  echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
    | sudo tee /etc/apt/sources.list.d/google-chrome.list > /dev/null
  wait_for_apt
  sudo -E apt update
  sudo -E apt install -y google-chrome-stable
else
  echo "Google Chrome already installed, skipping."
fi

###############################################################################
# Docker -- Docker CE from Docker's official apt repository                   #
###############################################################################

if ! command -v docker > /dev/null 2>&1; then
  echo "Installing Docker ..."
  sudo install -d -m 0755 /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
    | sudo gpg --dearmor --batch --yes -o /etc/apt/keyrings/docker.gpg
  sudo chmod a+r /etc/apt/keyrings/docker.gpg
  # shellcheck disable=SC1091
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
  wait_for_apt
  sudo -E apt update
  sudo -E apt install -y \
    docker-ce \
    docker-ce-cli \
    containerd.io \
    docker-buildx-plugin \
    docker-compose-plugin
else
  echo "Docker already installed, skipping."
fi

sudo systemctl enable --now docker

# Run docker without sudo. Group membership only takes effect in new sessions,
# so the current shell still needs sudo until the next login.
if ! id -nG "$USER" | tr ' ' '\n' | grep -qx docker; then
  echo "Adding $USER to the docker group ..."
  sudo usermod -aG docker "$USER"
  echo "Log out and back in (or run 'newgrp docker') to use docker without sudo."
fi

###############################################################################
# Postgres and Redis -- data services for deployed apps                      #
###############################################################################

# This box is a generic deploy target, so it does not choose which app runs
# here -- see the mise section above, and it does not create any
# app-specific roles or databases either. That's hand-done (per-environment
# users, created with a plain `sudo -u postgres psql`) and then handled by
# whatever setup scripts live in the app repo being deployed. All this script
# does is get one Postgres and one Redis instance running, on localhost only,
# for that hand-done setup to build on. Both come from apt (not Homebrew's
# compile-from-source problem on the old Mac target) and start on boot via
# systemd.
#
# Docker also runs on this box (see above), and an app's own docker-compose
# stack commonly maps a local-dev Postgres/Redis onto the standard ports
# (5432/6379) on the host. Put these two off the standard ports instead, so
# the two never collide and no app repo has to change its compose file.
# Override with DEPLOY_POSTGRES_PORT / DEPLOY_REDIS_PORT if these defaults
# ever collide with something else instead.
DEPLOY_POSTGRES_PORT="${DEPLOY_POSTGRES_PORT:-5433}"
DEPLOY_REDIS_PORT="${DEPLOY_REDIS_PORT:-6380}"

wait_for_apt
sudo -E apt install -y postgresql redis-server

sudo systemctl enable --now postgresql
sudo systemctl enable --now redis-server

# Postgres already defaults to listen_addresses = 'localhost' on Ubuntu, but
# pin it (and the port) explicitly with pg_conftool -- version-agnostic, it
# edits whichever cluster apt just created -- rather than trust the default
# to hold across releases. Only restart if something actually changed.
PG_VERSION="$(pg_lsclusters -h | awk '{print $1; exit}')"
if [ -n "$PG_VERSION" ]; then
  _pg_conf_before="$(sudo pg_conftool "$PG_VERSION" main show listen_addresses 2>/dev/null)|$(sudo pg_conftool "$PG_VERSION" main show port 2>/dev/null)"
  sudo pg_conftool "$PG_VERSION" main set listen_addresses localhost
  sudo pg_conftool "$PG_VERSION" main set port "$DEPLOY_POSTGRES_PORT"
  _pg_conf_after="$(sudo pg_conftool "$PG_VERSION" main show listen_addresses 2>/dev/null)|$(sudo pg_conftool "$PG_VERSION" main show port 2>/dev/null)"
  if [ "$_pg_conf_before" != "$_pg_conf_after" ]; then
    sudo systemctl restart postgresql
  fi
else
  echo "Could not determine the Postgres cluster version -- skipping listen_addresses/port check." >&2
fi

# Same idea for Redis: apt's default redis.conf already ships plain,
# uncommented "bind 127.0.0.1 -::1" and "port 6379" lines, so pin both
# explicitly with sed rather than rely on the package default holding.
#
# /etc/redis is mode 0750, owned by redis:redis, so an unprivileged `[ -f ]`
# or `grep` against a path under it reports "not found" (a permission-denied
# stat, not an absence) even when the file is right there -- do every check
# through sudo, the same as the edit and the restart, or the whole block
# silently skips itself with no error. Only restart if the file actually
# changed.
REDIS_CONF="/etc/redis/redis.conf"
if sudo test -f "$REDIS_CONF"; then
  _redis_conf_before="$(sudo md5sum "$REDIS_CONF")"
  sudo sed -i \
    -e 's/^bind .*/bind 127.0.0.1 -::1/' \
    -e "s/^port .*/port $DEPLOY_REDIS_PORT/" \
    "$REDIS_CONF"
  _redis_conf_after="$(sudo md5sum "$REDIS_CONF")"
  if [ "$_redis_conf_before" != "$_redis_conf_after" ]; then
    sudo systemctl restart redis-server
  fi
fi

###############################################################################
# Tailscale -- official apt repository                                        #
###############################################################################

if ! command -v tailscale > /dev/null 2>&1; then
  echo "Installing Tailscale ..."
  # shellcheck disable=SC1091
  DISTRO_CODENAME="$(. /etc/os-release && echo "$VERSION_CODENAME")"
  curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/${DISTRO_CODENAME}.noarmor.gpg" \
    | sudo tee /usr/share/keyrings/tailscale-archive-keyring.gpg > /dev/null
  curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/${DISTRO_CODENAME}.tailscale-keyring.list" \
    | sudo tee /etc/apt/sources.list.d/tailscale.list > /dev/null
  wait_for_apt
  sudo -E apt update
  sudo -E apt install -y tailscale
fi

sudo systemctl enable tailscaled
sudo systemctl start tailscaled

###############################################################################
# SSH -- openssh-server for remote access                                     #
###############################################################################

sudo -E apt install -y openssh-server
sudo systemctl enable ssh
sudo systemctl start ssh

[ -f ~/.ssh/id_ed25519 ] || ssh-keygen -t ed25519 -N '' -f ~/.ssh/id_ed25519 -C "$USER@$(hostname)"

###############################################################################
# zsh                                                                         #
###############################################################################

shell_path="$(command -v zsh)"
echo "Ensuring default shell is zsh at '$shell_path' ..."
if ! grep "$shell_path" /etc/shells > /dev/null 2>&1; then
  sudo sh -c "echo $shell_path >> /etc/shells"
fi
if [ "$SHELL" != "$shell_path" ]; then
  sudo chsh -s "$shell_path" "$USER"
fi

###############################################################################
# WiFi reliability -- headless box has no one to notice a dropped connection #
###############################################################################

wait_for_apt
sudo -E apt install -y wireless-tools

WIFI_DISPATCHER="/etc/NetworkManager/dispatcher.d/99-wifi-powersave"
# shellcheck disable=SC2016
WIFI_DISPATCHER_CONTENT='#!/bin/sh
# Disable WiFi power management on connect
[ "$2" = "up" ] && iwconfig "$1" power off 2>/dev/null || true
'
if [ "$(sudo cat "$WIFI_DISPATCHER" 2>/dev/null)" != "$(printf '%s' "$WIFI_DISPATCHER_CONTENT")" ]; then
  printf '%s' "$WIFI_DISPATCHER_CONTENT" | sudo tee "$WIFI_DISPATCHER" > /dev/null
fi
sudo chmod +x "$WIFI_DISPATCHER"

# Mask sleep/suspend targets so nothing ever puts the box (and its WiFi) to
# sleep. mask is idempotent -- it's a no-op if already masked.
sudo systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target

# Cron-based watchdog: ping the default gateway every minute and restart
# NetworkManager if it doesn't answer. Runs from root's crontab, not the
# user's, since restarting NetworkManager needs root.
# shellcheck disable=SC2016
WIFI_CRON='* * * * * ping -c 1 -W 5 $(ip route | grep default | awk '"'"'{print $3}'"'"') > /dev/null 2>&1 || systemctl restart NetworkManager'
if ! sudo crontab -l 2>/dev/null | grep -qF "$WIFI_CRON"; then
  (sudo crontab -l 2>/dev/null; echo "$WIFI_CRON") | sudo crontab -
fi

###############################################################################
# Time sync -- clock skew breaks OAuth flows and GitHub Actions auth         #
###############################################################################

if ! systemctl list-unit-files systemd-timesyncd.service > /dev/null 2>&1; then
  sudo -E apt install -y systemd-timesyncd
fi
sudo systemctl enable --now systemd-timesyncd

###############################################################################
# GitHub Actions self-hosted runner -- opt in with GITHUB_RUNNER_REPO         #
###############################################################################

# Off by default. Set GITHUB_RUNNER_REPO to "owner/name" and this box registers
# itself as a self-hosted runner for that repo, as a systemd service so it comes
# back after a reboot. Skipped entirely otherwise -- a plain dev box has no use
# for a 100MB+ download it will never register. Once a runner is installed here
# the section keeps running on later passes, so re-runs stay idempotent without
# having to re-supply anything.
#
# Registration tokens last about an hour, so rather than making a human paste
# one in, the script mints its own through gh -- the endpoint wants repo admin,
# which is inside the repo scope "gh auth login" already grants. gh also reads
# GH_TOKEN/GITHUB_TOKEN from the environment, so a box that has not been through
# "gh auth login" can still register by passing a personal access token that
# way. GITHUB_RUNNER_TOKEN (or the first argument) overrides with a token minted
# elsewhere. When none of that works the runner is left installed and
# unregistered, with a manual step in the summary, so a later run picks up
# exactly where this one left off.
#
# Outbound to GitHub only: the service holds its own connection out and gets
# jobs dispatched over it, so there is nothing to poll and no inbound port.

RUNNER_DIR="$HOME/actions-runner"
RUNNER_REPO="${GITHUB_RUNNER_REPO:-}"
RUNNER_TOKEN="${GITHUB_RUNNER_TOKEN:-${1:-}}"
RUNNER_REGISTERED=0
RUNNER_SUMMARY="not installed (set GITHUB_RUNNER_REPO to opt in)"

if [ -n "$RUNNER_REPO" ] || [ -f "$RUNNER_DIR/config.sh" ]; then
  # Jobs that deploy elsewhere run ssh from here. openssh-server pulls the
  # client in already, but the runner's one real dependency shouldn't be left
  # implicit.
  if ! command -v ssh > /dev/null 2>&1; then
    echo "Installing OpenSSH client ..."
    sudo -E apt install -y openssh-client
  else
    echo "OpenSSH client already installed, skipping."
  fi

  if [ ! -f "$RUNNER_DIR/config.sh" ]; then
    echo "Installing the GitHub Actions runner ..."
    case "$(uname -m)" in
      x86_64) RUNNER_ARCH="x64" ;;
      aarch64 | arm64) RUNNER_ARCH="arm64" ;;
      armv7l) RUNNER_ARCH="arm" ;;
      *)
        echo "No GitHub Actions runner build for $(uname -m)." >&2
        exit 1
        ;;
    esac

    # Resolved at run time rather than pinned -- the runner self-updates from
    # whatever it lands on, so a stale pin here would be rewritten anyway.
    RUNNER_VERSION="$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest \
      | jq -r .tag_name | sed 's/^v//')"
    if [ -z "$RUNNER_VERSION" ]; then
      echo "Could not resolve the latest GitHub Actions runner release." >&2
      exit 1
    fi
    RUNNER_TGZ="actions-runner-linux-${RUNNER_ARCH}-${RUNNER_VERSION}.tar.gz"

    mkdir -p "$RUNNER_DIR"
    curl -fsSL -o "/tmp/$RUNNER_TGZ" \
      "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/${RUNNER_TGZ}"
    tar xzf "/tmp/$RUNNER_TGZ" -C "$RUNNER_DIR"
    rm -f "/tmp/$RUNNER_TGZ"

    # .NET runtime libraries (libicu, libssl, libkrb5 ...). The runner ships its
    # own installer, which knows the package-name drift across Ubuntu releases.
    wait_for_apt
    sudo -E "$RUNNER_DIR/bin/installdependencies.sh"
  else
    echo "GitHub Actions runner already installed, skipping download."
  fi

  # config.sh writes .runner once registration succeeds -- that file is the
  # "already registered" marker, and keeps re-runs from minting a token they
  # have no use for.
  if [ -f "$RUNNER_DIR/.runner" ]; then
    echo "GitHub Actions runner already registered, skipping configuration."
    RUNNER_REGISTERED=1
  elif [ -z "$RUNNER_REPO" ]; then
    echo "GITHUB_RUNNER_REPO not set, skipping runner registration."
  else
    if [ -z "$RUNNER_TOKEN" ]; then
      echo "Minting a runner registration token via gh ..."
      # gh writes the error body to stdout when a call fails, so only its exit
      # status can be trusted here -- take the output on faith and config.sh
      # gets handed a JSON error blob as a registration token.
      RUNNER_TOKEN="$(gh api -X POST \
        "repos/$RUNNER_REPO/actions/runners/registration-token" \
        --jq .token 2> /dev/null)" || RUNNER_TOKEN=""
    fi

    if [ -n "$RUNNER_TOKEN" ]; then
      echo "Registering the GitHub Actions runner with $RUNNER_REPO ..."
      (
        cd "$RUNNER_DIR" && ./config.sh \
          --unattended \
          --replace \
          --url "https://github.com/$RUNNER_REPO" \
          --token "$RUNNER_TOKEN" \
          --name "$(hostname)" \
          --work _work
      )
      RUNNER_REGISTERED=1
    else
      echo "gh could not mint a registration token, skipping runner registration."
    fi
  fi

  if [ "$RUNNER_REGISTERED" -eq 1 ]; then
    # svc.sh writes a real unit to /etc/systemd/system, daemon-reloads and
    # enables it. It refuses to install over an existing unit, and its status
    # subcommand exits non-zero when there is none, which is the guard.
    if ! (cd "$RUNNER_DIR" && sudo ./svc.sh status) > /dev/null 2>&1; then
      echo "Installing the GitHub Actions runner as a systemd service ..."
      (cd "$RUNNER_DIR" && sudo ./svc.sh install "$USER")
    fi
    (cd "$RUNNER_DIR" && sudo ./svc.sh start)
    RUNNER_SUMMARY="registered, running as a systemd service"
  else
    RUNNER_SUMMARY="installed in $RUNNER_DIR, registration pending (see manual steps)"
  fi
fi

###############################################################################
# No desktop -- boot straight to a multi-user console                        #
###############################################################################

sudo systemctl set-default multi-user.target

###############################################################################
# Summary                                                                     #
###############################################################################

LOCAL_IP="$(hostname -I | awk '{print $1}')"

echo ""
echo "============================================================"
echo "Setup complete."
echo ""
echo "Local IP:  $LOCAL_IP"
echo "SSH:       ssh $USER@$LOCAL_IP"
echo "Runner:    $RUNNER_SUMMARY"
echo ""
echo "Deploy target:"
echo "  mise:     installed and activated for login shells. No Node version is"
echo "            pinned for deploys -- they bring their own via"
echo "            mise.toml/.nvmrc; the global LTS pin is only a fallback."
echo "  Postgres: listening on localhost:$DEPLOY_POSTGRES_PORT (off 5432 so a"
echo "            docker-compose dev stack can still use it)."
echo "  Redis:    listening on localhost:$DEPLOY_REDIS_PORT (off 6379, same"
echo "            reason), shared by every environment -- apps namespace"
echo "            their own keys."
echo "  Users:    none created here -- add one per environment by hand, e.g."
echo "            sudo -u postgres psql -c \"CREATE USER staging WITH LOGIN PASSWORD '...'\""
echo ""
echo "Manual steps:"
echo "  - Set git identity: git config --global user.name \"Name\" && git config --global user.email \"you@example.com\""
echo "  - Authenticate GitHub CLI: gh auth login"
echo "  - Authenticate Claude Code CLI: claude (interactive TTY required)"
echo "  - Authenticate Tailscale: sudo tailscale up"
if [ "$RUNNER_REGISTERED" -ne 1 ] && [ -f "$RUNNER_DIR/config.sh" ]; then
  echo "  - Register the GitHub Actions self-hosted runner. It registers itself on"
  echo "    the next run once GITHUB_RUNNER_REPO names the repo and gh can reach"
  echo "    it -- so 'gh auth login' above, then re-run this script:"
  echo "      curl -H \"Cache-Control: no-cache\" -fsS \\"
  echo "        'https://raw.githubusercontent.com/jonstorer/laptop/main/ubuntu' \\"
  echo "        | GITHUB_RUNNER_REPO=owner/name sh"
  echo "    Add GH_TOKEN=<personal access token with repo scope> if gh is not"
  echo "    authenticated on this box."
fi
echo "============================================================"
