#!/bin/sh

# Welcome to the alpine jumpbox setup script!
#
# Headless Alpine Linux Tailscale relay box (ProxyJump target only). Runs
# tailscaled and sshd via OpenRC with no user logged in.

set -e

# Run logging -- append one tab-separated line per run to ~/.laptop/runs.log so
# it's easy to see which script ran on which host, when, for how long, against
# which repo commit, and whether it succeeded. The commit is fetched lazily at
# exit (via curl or wget) and falls back to "unknown" when offline or unset.
LAPTOP_SCRIPT="alpine-jumpbox"
LAPTOP_RUN_START=$(date +%s)

log_run() {
  _ret="$1"
  _dur=$(( $(date +%s) - LAPTOP_RUN_START ))
  if [ "$_ret" -eq 0 ]; then _outcome="ok"; else _outcome="fail"; fi
  _api="https://api.github.com/repos/jonstorer/laptop/commits/main"
  _commit=$( { curl -fsSL "$_api" 2>/dev/null || wget -qO- "$_api" 2>/dev/null; } \
    | grep -m1 '"sha"' | cut -d'"' -f4 | cut -c1-12)
  [ -n "$_commit" ] || _commit="unknown"
  mkdir -p "$HOME/.laptop"
  printf '%s\t%s\t%s\t%s\t%s\t%ss\texit=%s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
    "$LAPTOP_SCRIPT" "$(hostname)" "$_commit" \
    "$_outcome" "$_dur" "$_ret" >> "$HOME/.laptop/runs.log"
}

# shellcheck disable=SC2154
trap 'ret=$?; log_run "$ret"; test $ret -ne 0 && printf "failed\n\n" >&2; exit $ret' EXIT

# Privilege helper -- Alpine has no sudo by default. Run as-is when already
# root, otherwise use doas or sudo if present.
if [ "$(id -u)" -eq 0 ]; then
  SUDO=""
elif command -v doas >/dev/null 2>&1; then
  SUDO="doas"
elif command -v sudo >/dev/null 2>&1; then
  SUDO="sudo"
else
  echo "Run this script as root, or install doas/sudo first." >&2
  exit 1
fi

# Enable the community repo (tailscale lives there) if it isn't already.
apk_repos="/etc/apk/repositories"
if ! grep -qE '^[^#].*/community$' "$apk_repos"; then
  if grep -qE '^#.*/community$' "$apk_repos"; then
    # shellcheck disable=SC2086
    $SUDO sed -i -E 's|^#(.*/community)$|\1|' "$apk_repos"
  else
    alpine_version=$(cut -d'.' -f1,2 /etc/alpine-release)
    # shellcheck disable=SC2086
    $SUDO sh -c "echo 'https://dl-cdn.alpinelinux.org/alpine/v${alpine_version}/community' >> $apk_repos"
  fi
fi

# shellcheck disable=SC2086
$SUDO apk update

# shellcheck disable=SC2086
$SUDO apk add openssh tailscale tailscale-openrc ca-certificates doas

# No mDNS on this box -- it's reached by Tailscale IP.
if apk info -e avahi >/dev/null 2>&1; then
  echo "Warning: avahi is installed but not required by this script; not removing it." >&2
fi

# Enable and start services via OpenRC.
for svc in sshd tailscale; do
  if ! rc-update show default 2>/dev/null | grep -q "^ *${svc} *|"; then
    # shellcheck disable=SC2086
    $SUDO rc-update add "$svc" default
  fi
  if ! rc-service "$svc" status 2>/dev/null | grep -q started; then
    # shellcheck disable=SC2086
    $SUDO rc-service "$svc" start
  fi
done

# Create the login user (fresh off `setup-alpine -q`, only root exists yet)
# and let it escalate via doas -- adduser -D leaves the account passwordless,
# so doas is configured to not prompt for one.
jumpbox_user="${LAPTOP_SSH_USER:-jumpbox}"
if ! id "$jumpbox_user" >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  $SUDO adduser -D -s /bin/ash "$jumpbox_user"
  # shellcheck disable=SC2086
  $SUDO addgroup "$jumpbox_user" wheel
fi

# shellcheck disable=SC2086
$SUDO mkdir -p /etc/doas.d
if ! grep -qs '^permit nopass :wheel$' /etc/doas.d/doas.conf; then
  echo 'permit nopass :wheel' | $SUDO tee -a /etc/doas.d/doas.conf >/dev/null
fi

user_home=$(getent passwd "$jumpbox_user" | cut -d: -f6)
ssh_dir="$user_home/.ssh"
auth_keys="$ssh_dir/authorized_keys"

# shellcheck disable=SC2086
$SUDO mkdir -p "$ssh_dir"
# shellcheck disable=SC2086
[ -f "$auth_keys" ] || $SUDO sh -c "touch $auth_keys"
# shellcheck disable=SC2086
$SUDO chown -R "$jumpbox_user:$jumpbox_user" "$ssh_dir"
# shellcheck disable=SC2086
$SUDO chmod 700 "$ssh_dir"
# shellcheck disable=SC2086
$SUDO chmod 600 "$auth_keys"

default_pubkey="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEvadfIkdsxO2zZm0Nkv8wAojLustJ/3Wh3xELuIp3M7 jonathon@Jonathon-Storer-NYC"

# Fill in a key when none is on file yet. Reads from /dev/tty since this
# script is normally run via curl|sh, which occupies stdin.
if [ ! -s "$auth_keys" ]; then
  pubkey="$default_pubkey"
  if [ -r /dev/tty ]; then
    echo "Paste an SSH public key for $jumpbox_user (or press Enter to use the default jonathon@Jonathon-Storer-NYC key):"
    read -r input_key < /dev/tty
    [ -z "$input_key" ] || pubkey="$input_key"
  fi
  printf '%s\n' "$pubkey" | $SUDO tee -a "$auth_keys" >/dev/null
fi

drop_in="/etc/ssh/sshd_config.d/99-jumpbox.conf"
sshd_config="/etc/ssh/sshd_config"

if ! grep -q '^Include /etc/ssh/sshd_config.d/\*.conf' "$sshd_config" 2>/dev/null; then
  # shellcheck disable=SC2086
  $SUDO sh -c "printf 'Include /etc/ssh/sshd_config.d/*.conf\n' | cat - $sshd_config > ${sshd_config}.new && mv ${sshd_config}.new $sshd_config"
fi

new_drop_in=$(cat <<'EOF'
PasswordAuthentication no
PubkeyAuthentication yes
KbdInteractiveAuthentication no
PermitRootLogin no
AllowTcpForwarding yes
X11Forwarding no
EOF
)
old_drop_in=""
[ -f "$drop_in" ] && old_drop_in=$(cat "$drop_in")

if [ "$new_drop_in" != "$old_drop_in" ]; then
  # shellcheck disable=SC2086
  $SUDO mkdir -p "$(dirname "$drop_in")"
  printf '%s\n' "$new_drop_in" | $SUDO tee "$drop_in" >/dev/null
  # shellcheck disable=SC2086
  $SUDO sshd -t
  # shellcheck disable=SC2086
  $SUDO rc-service sshd restart
fi

echo ""
echo "== alpine-jumpbox setup summary =="
echo "sshd hardened: password auth disabled, pubkey only."
if [ ! -s "$auth_keys" ]; then
  echo "Note: $auth_keys is still empty -- paste your public key in before you disconnect."
fi

echo ""
if tailscale_ip=$(tailscale ip -4 2>/dev/null) && [ -n "$tailscale_ip" ]; then
  echo "Tailscale is up. IP: $tailscale_ip"
elif [ -r /dev/tty ]; then
  # Tailscale has no username/password login -- `tailscale up` prints a URL
  # for browser-based SSO and blocks here until you finish it there.
  echo "Starting Tailscale login -- open the URL below to authenticate:"
  # shellcheck disable=SC2086
  $SUDO tailscale up --hostname=jumpbox < /dev/tty
  tailscale_ip=$(tailscale ip -4 2>/dev/null) || tailscale_ip="<new-alpine-tailscale-ip>"
else
  echo "Tailscale is not authenticated yet. Run:"
  echo "  $SUDO tailscale up --hostname=jumpbox"
  echo "then re-run this script (or run 'tailscale ip -4') to get the IP."
  tailscale_ip="<new-alpine-tailscale-ip>"
fi

echo ""
echo "Drop this into ~/.ssh/config on your Mac:"
echo ""
echo "Host jumpbox"
echo "  User $jumpbox_user"
echo "  HostName $tailscale_ip"
echo "  IdentityFile ~/.ssh/personal_id_ed25519"
echo "  IdentitiesOnly yes"
echo "  PreferredAuthentications publickey"
echo "  ControlMaster auto"
echo "  ControlPath ~/.ssh/cm-%C"
echo "  ControlPersist 10m"
