#!/bin/sh

# Welcome to the mac-bluebubbles machine script!
# Sets up macOS as an iMessage bridge via BlueBubbles, which exposes
# Messages.app via a web API for other machines to connect to.
# Also provisions the box as a generic Node app deploy target: mise for
# runtime versions, plus Postgres and Valkey (a Redis-compatible server). It
# deliberately knows nothing about which app gets deployed here or what its
# processes are called.
# After this script completes, follow the manual steps shown in the summary.

# Ask for sudo upfront so we don't have to get it later
sudo -v

# Keep using sudo so the permissions don't time out
while true; do sudo -n true; sleep 10; kill -0 "$$" || exit; done 2>/dev/null &

# Run logging -- append one tab-separated line per run to ~/.laptop/runs.log so
# it's easy to see which script ran on which host, when, for how long, against
# which repo commit, and whether it succeeded. The commit is fetched lazily at
# exit (via curl or wget) and falls back to "unknown" when offline or unset.
LAPTOP_SCRIPT="mac-bluebubbles"
LAPTOP_RUN_START=$(date +%s)

log_run() {
  _ret="$1"
  _dur=$(( $(date +%s) - LAPTOP_RUN_START ))
  if [ "$_ret" -eq 0 ]; then _outcome="ok"; else _outcome="fail"; fi
  _api="https://api.github.com/repos/jonstorer/laptop/commits/main"
  _commit=$( { curl -fsSL "$_api" 2>/dev/null || wget -qO- "$_api" 2>/dev/null; } \
    | grep -m1 '"sha"' | cut -d'"' -f4 | cut -c1-12)
  [ -n "$_commit" ] || _commit="unknown"
  mkdir -p "$HOME/.laptop"
  printf '%s\t%s\t%s\t%s\t%s\t%ss\texit=%s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
    "$LAPTOP_SCRIPT" "$(hostname)" "$_commit" \
    "$_outcome" "$_dur" "$_ret" >> "$HOME/.laptop/runs.log"
}

# shellcheck disable=SC2154
trap 'ret=$?; log_run "$ret"; test $ret -ne 0 && printf "failed\n\n" >&2; exit $ret' EXIT
set -e

###############################################################################
# Homebrew                                                                    #
###############################################################################

if ! command -v brew > /dev/null 2>&1; then
  echo "Installing Homebrew ..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL 'https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh')"
fi

# x86_64: /usr/local  |  arm64: /opt/homebrew
if [ "$(uname -m)" = "arm64" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  eval "$(/usr/local/bin/brew shellenv)"
fi

echo "Updating Homebrew ..."
brew update --force

# Homebrew ships no bottles for Intel macOS, so every outdated formula is
# rebuilt from source -- and some (anything needing rust or llvm) take hours
# or break outright. On Intel, install what's missing but leave installed
# formulae alone; casks are prebuilt binaries, so those still upgrade.
if [ "$(uname -m)" = "arm64" ]; then
  _bundle_flags=""
else
  _bundle_flags="--no-upgrade"
fi

# Adopt any cask below that's already present but wasn't installed via
# Homebrew (e.g. an app installed by hand) instead of failing the whole bundle.
export HOMEBREW_CASK_OPTS="--adopt"

# --adopt only covers casks. Formulae have no equivalent: if something other
# than Homebrew already put a tailscale CLI in the bin dir (e.g. the Tailscale
# app's "Install CLI"), brew can't link its own and fails the bundle. Leave
# tailscale to whatever installed it -- Homebrew's links point into Cellar,
# so anything else at that path is someone else's.
_tailscale_bin="$(brew --prefix)/bin/tailscale"
if { [ -e "$_tailscale_bin" ] || [ -L "$_tailscale_bin" ]; } &&
   ! readlink "$_tailscale_bin" 2>/dev/null | grep -q '/Cellar/tailscale/'; then
  echo "Found a non-Homebrew tailscale at $_tailscale_bin -- skipping Homebrew's ..."
  _tailscale_brew=""
else
  _tailscale_brew='brew "tailscale"'
fi

# shellcheck disable=SC2086
brew bundle $_bundle_flags --file=- <<EOF
# GUI apps -- for physical access / debugging
cask "alfred"
cask "bluebubbles"
cask "iterm2"
cask "rectangle"

# Browser -- used by BlueBubbles web interface
cask "google-chrome"

# Config manipulation
brew "jq"
brew "yq"

# Networking
brew "curl"
brew "wget"
$_tailscale_brew

# Terminal multiplexer
brew "tmux"

# Data services -- available to whatever gets deployed to this box.
# "postgresql" is an alias for the current major (postgresql@18 today); it
# floats on major releases, so a major bump needs a manual data-dir migration.
# Valkey instead of Redis: Homebrew's redis needs rust (and so llvm) to build,
# which is unbuildable-in-practice on Intel. Valkey speaks the same protocol
# on the same port (6379) and builds with plain make.
brew "postgresql"
brew "valkey"
EOF

if [ "$(uname -m)" = "arm64" ]; then
  brew upgrade
else
  brew upgrade --cask
fi

###############################################################################
# Node -- provided by mise, so remove any Homebrew node that shadows it      #
###############################################################################

# A brew-linked node/node@NN puts binaries in the Homebrew bin dir, which sits
# ahead of mise's shims on PATH and wins. Uninstall any that are already on
# this Mac -- everything running here gets its Node from mise, so nothing
# depends on a Homebrew one. The loop only visits formulae brew actually
# reports, so re-running is a no-op.
for _node_formula in $(brew list --formula 2>/dev/null | grep -E '^node(@[0-9.]+)?$' || true); do
  echo "Uninstalling Homebrew $_node_formula -- Node comes from mise ..."
  brew uninstall "$_node_formula"
done

###############################################################################
# mise -- runtime version manager                                            #
###############################################################################

# This box is a generic deploy target, so it does not choose a Node version:
# whatever gets deployed pins its own via mise.toml/.nvmrc and mise resolves
# it. Installed from mise's prebuilt binary rather than Homebrew, whose mise
# formula builds from source (rust + llvm) on Intel.
export PATH="$HOME/.local/bin:$PATH"
if ! command -v mise > /dev/null 2>&1; then
  echo "Installing mise ..."
  curl -fsSL https://mise.run | sh
fi

if command -v mise > /dev/null 2>&1; then
  echo "Activating mise for login shells ..."

  ZPROFILE="$HOME/.zprofile.local"
  if ! grep -qF 'mise activate' "$ZPROFILE" 2>/dev/null; then
    # shellcheck disable=SC2016
    printf '\nexport PATH="$HOME/.local/bin:$PATH"\neval "$(mise activate zsh)"\n' >> "$ZPROFILE"
  fi

  # Shell init (.zshrc) is managed by dotfiles - do not modify
fi

###############################################################################
# Postgres and Valkey -- data services for deployed apps                     #
###############################################################################

# Started the same way as tailscale below: a root LaunchDaemon, so they come
# back after a reboot without anyone logging in. Re-running is a no-op.
echo "Starting Postgres and Valkey ..."
sudo brew services start postgresql
sudo brew services start valkey

###############################################################################
# SSH -- enable Remote Login for remote access                               #
###############################################################################

pgrep sshd > /dev/null 2>&1 || \
  sudo launchctl load -w /System/Library/LaunchDaemons/ssh.plist

###############################################################################
# Screen Sharing -- enable for remote desktop                                #
###############################################################################

nc -z localhost 5900 2>/dev/null || \
  sudo launchctl load -w /System/Library/LaunchDaemons/com.apple.screensharing.plist

###############################################################################
# Tailscale -- start daemon (run 'sudo tailscale up' to authenticate)       #
###############################################################################

# Only when Homebrew owns tailscale; otherwise whatever installed it runs it.
if [ -n "$_tailscale_brew" ]; then
  sudo brew services start tailscale
fi

###############################################################################
# Internet Sharing -- en2 (WiFi) to en0, en1 (Ethernet)                     #
###############################################################################

# com.apple.nat.plist is already configured -- just ensure the service is running
sudo launchctl load -w /System/Library/LaunchDaemons/com.apple.InternetSharing.plist 2>/dev/null || true

###############################################################################
# poke-messages -- keep Messages.app alive for BlueBubbles                  #
###############################################################################

# Messages.app can go idle on autonomous setups and miss incoming messages.
# This LaunchAgent pokes it every 5 minutes to keep it responsive.
POKE_SCRIPT="$HOME/Scripts/poke-messages.scpt"
POKE_PLIST="$HOME/Library/LaunchAgents/com.user.poke-messages.plist"

mkdir -p "$HOME/Scripts"
cat > "$POKE_SCRIPT" <<'SCPT'
tell application "Messages"
    launch
    count every chat
end tell
SCPT

mkdir -p "$HOME/Library/LaunchAgents"
cat > "$POKE_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.poke-messages</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/osascript</string>
        <string>$HOME/Scripts/poke-messages.scpt</string>
    </array>
</dict>
</plist>
EOF

# Idempotent load: unload if already running, then reload
launchctl bootout "gui/$(id -u)/com.user.poke-messages" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$POKE_PLIST"

###############################################################################
# zsh                                                                         #
###############################################################################

shell_path="$(command -v zsh)"
echo "Ensuring default shell is zsh at '$shell_path' ..."
if ! grep "$shell_path" /etc/shells > /dev/null 2>&1; then
  sudo sh -c "echo $shell_path >> /etc/shells"
fi
if [ "$SHELL" != "$shell_path" ]; then
  sudo chsh -s "$shell_path" "$USER"
fi

###############################################################################
# macOS defaults -- automation-friendly only                                 #
###############################################################################

echo "Configuring macOS defaults ..."

# Keep background processes alive
defaults write NSGlobalDomain NSDisableAutomaticTermination -bool true

# No iCloud document syncing
defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false

# Reveal IP address, hostname, OS version when clicking clock in login window
sudo defaults write /Library/Preferences/com.apple.loginwindow AdminHostInfo HostName

# Locale
defaults write NSGlobalDomain AppleLanguages -array "en"
defaults write NSGlobalDomain AppleLocale -string "en_US@currency=USD"
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false

# Require password immediately after screensaver
defaults write com.apple.screensaver askForPassword -int 1
defaults write com.apple.screensaver askForPasswordDelay -int 0

# No .DS_Store on network volumes
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true

# No confirmation dialogs that could block automation
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false
defaults write com.apple.finder WarnOnEmptyTrash -bool false

for app in "Dock" "Finder" "SystemUIServer"; do
  killall "$app" > /dev/null 2>&1 || true
done

echo "macOS defaults configured."

###############################################################################
# TODO.md -- manual steps with live status                                   #
###############################################################################

_ok() { sh -c "$1" > /dev/null 2>&1 && printf 'x' || printf ' '; }

_TS=$(_ok "tailscale status")
_BB=$(_ok "pgrep -x BlueBubbles")
_GENERATED=$(date '+%Y-%m-%d %H:%M:%S')
TODO_FILE="$HOME/TODO.md"

cat > "$TODO_FILE" <<EOF
# Mac BlueBubbles Setup

_Last updated: $_GENERATED — rerun mac-bluebubbles to refresh status._

- [$_TS] Authenticate Tailscale: \`sudo tailscale up\`
- [$_BB] Launch BlueBubbles, sign in with Apple ID, enable REST API (Settings → Server → enable REST API), note the server URL and password
- [ ] Approve Automation permission — macOS will prompt when osascript first accesses Messages.app; allow in System Settings → Privacy & Security → Automation
- [ ] Sign into iMessage — Messages.app → Settings → iMessage
- [ ] On the machine connecting to this bridge, supply the BlueBubbles server URL and password
EOF

###############################################################################
# Summary                                                                     #
###############################################################################

LOCAL_IP="$(ipconfig getifaddr en2 2>/dev/null || echo 'unknown')"

# Same port-probe idiom used for Screen Sharing above. A service that was just
# started may still be opening its socket, hence "starting" rather than "down".
if nc -z localhost 5432 2>/dev/null; then
  _PG_STATUS="listening on 5432"
else
  _PG_STATUS="starting -- check 'sudo brew services list'"
fi
if nc -z localhost 6379 2>/dev/null; then
  _VALKEY_STATUS="listening on 6379"
else
  _VALKEY_STATUS="starting -- check 'sudo brew services list'"
fi

echo ""
echo "============================================================"
echo "Setup complete. This Mac is an iMessage bridge via BlueBubbles"
echo "and a Node app deploy target."
echo ""
echo "Local IP (WiFi):  $LOCAL_IP"
echo "SSH:              ssh $USER@$LOCAL_IP"
echo "Screen Sharing:   vnc://$LOCAL_IP"
echo ""
echo "Tailscale: daemon started -- run 'sudo tailscale up' to authenticate."
echo "After auth, SSH and Screen Sharing work from anywhere via Tailscale IP."
echo ""
echo "Deploy target:"
echo "  mise:     installed and activated for login shells. No Node version is"
echo "            pinned here -- deploys bring their own via mise.toml/.nvmrc."
echo "  Postgres: $_PG_STATUS (brew services, postgresql)"
echo "  Valkey:   $_VALKEY_STATUS (brew services, valkey; Redis-compatible)"
echo ""
echo "Manual steps: $TODO_FILE"
echo "============================================================"
