#!/bin/sh

# Welcome to the mac-bluebubbles machine script!
# Sets up macOS as an iMessage bridge via BlueBubbles, which exposes
# Messages.app via a web API for other machines to connect to. It runs
# nothing else -- apps that use the bridge live elsewhere and reach it over
# Tailscale.
# After this script completes, follow the manual steps shown in the summary.

# Ask for sudo upfront so we don't have to get it later
sudo -v

# Keep using sudo so the permissions don't time out
while true; do sudo -n true; sleep 10; kill -0 "$$" || exit; done 2>/dev/null &

# Run logging -- append one tab-separated line per run to ~/.laptop/runs.log so
# it's easy to see which script ran on which host, when, for how long, against
# which repo commit, and whether it succeeded. The commit is fetched lazily at
# exit (via curl or wget) and falls back to "unknown" when offline or unset.
LAPTOP_SCRIPT="mac-bluebubbles"
LAPTOP_RUN_START=$(date +%s)

log_run() {
  _ret="$1"
  _dur=$(( $(date +%s) - LAPTOP_RUN_START ))
  if [ "$_ret" -eq 0 ]; then _outcome="ok"; else _outcome="fail"; fi
  _api="https://api.github.com/repos/jonstorer/laptop/commits/main"
  _commit=$( { curl -fsSL "$_api" 2>/dev/null || wget -qO- "$_api" 2>/dev/null; } \
    | grep -m1 '"sha"' | cut -d'"' -f4 | cut -c1-12)
  [ -n "$_commit" ] || _commit="unknown"
  mkdir -p "$HOME/.laptop"
  printf '%s\t%s\t%s\t%s\t%s\t%ss\texit=%s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
    "$LAPTOP_SCRIPT" "$(hostname)" "$_commit" \
    "$_outcome" "$_dur" "$_ret" >> "$HOME/.laptop/runs.log"
}

# shellcheck disable=SC2154
trap 'ret=$?; log_run "$ret"; test $ret -ne 0 && printf "failed\n\n" >&2; exit $ret' EXIT
set -e

###############################################################################
# Homebrew                                                                    #
###############################################################################

if ! command -v brew > /dev/null 2>&1; then
  echo "Installing Homebrew ..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL 'https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh')"
fi

# x86_64: /usr/local  |  arm64: /opt/homebrew
if [ "$(uname -m)" = "arm64" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  eval "$(/usr/local/bin/brew shellenv)"
fi

echo "Updating Homebrew ..."
brew update --force

# Homebrew ships no bottles for Intel macOS, so every outdated formula is
# rebuilt from source -- and some (anything needing rust or llvm) take hours
# or break outright. On Intel, install what's missing but leave installed
# formulae alone; casks are prebuilt binaries, so those still upgrade.
if [ "$(uname -m)" = "arm64" ]; then
  _bundle_flags=""
else
  _bundle_flags="--no-upgrade"
fi

# Adopt any cask below that's already present but wasn't installed via
# Homebrew (e.g. an app installed by hand) instead of failing the whole bundle.
export HOMEBREW_CASK_OPTS="--adopt"

# --adopt only covers casks. Formulae have no equivalent: if something other
# than Homebrew already put a tailscale CLI in the bin dir (e.g. the Tailscale
# app's "Install CLI"), brew can't link its own and fails the bundle. Leave
# tailscale to whatever installed it -- Homebrew's links point into Cellar,
# so anything else at that path is someone else's.
_tailscale_bin="$(brew --prefix)/bin/tailscale"
if { [ -e "$_tailscale_bin" ] || [ -L "$_tailscale_bin" ]; } &&
   ! readlink "$_tailscale_bin" 2>/dev/null | grep -q '/Cellar/tailscale/'; then
  echo "Found a non-Homebrew tailscale at $_tailscale_bin -- skipping Homebrew's ..."
  _tailscale_brew=""
else
  _tailscale_brew='brew "tailscale"'
fi

# shellcheck disable=SC2086
brew bundle $_bundle_flags --file=- <<EOF
# GUI apps for logging in at the box itself; otherwise it's managed over SSH.
# BlueBubbles itself is installed below, not here. Keep this list in sync with
# _keep_casks in the cleanup below.
cask "alfred"
cask "iterm2"
cask "rectangle"

# Config manipulation
brew "jq"
brew "yq"

# Networking
brew "curl"
brew "wget"
$_tailscale_brew

# Health monitoring -- SMART status for the health-check LaunchDaemon below
brew "smartmontools"

# Terminal multiplexer
brew "tmux"
EOF

if [ "$(uname -m)" = "arm64" ]; then
  brew upgrade
else
  brew upgrade --cask
fi

###############################################################################
# BlueBubbles -- installed from its GitHub release, not Homebrew             #
###############################################################################

# Homebrew disabled the bluebubbles cask on 2026-09-01 because the app isn't
# notarized (fails Gatekeeper), so brew refuses to install it. Install the
# same release the cask pinned, checked against the cask's checksums. A Mac
# that already has the app (including one installed by the old cask) is left
# alone. BlueBubbles updates itself from inside the app.
BLUEBUBBLES_APP="/Applications/BlueBubbles.app"
if [ ! -d "$BLUEBUBBLES_APP" ]; then
  _bb_version="1.9.9"
  if [ "$(uname -m)" = "arm64" ]; then
    _bb_dmg="BlueBubbles-$_bb_version-arm64.dmg"
    _bb_sha256="fafd650c883f52e7494a6625e45249f2144d197378a4d57143ccf6198bb2e862"
  else
    _bb_dmg="BlueBubbles-$_bb_version.dmg"
    _bb_sha256="9681e65f60214a6a95f3bd12b57bd4cc8ad6d8f58cd9c1d8811b2a4606ad7c04"
  fi

  echo "Installing BlueBubbles $_bb_version ..."
  _bb_tmp="$(mktemp -d)"
  curl -fsSL -o "$_bb_tmp/$_bb_dmg" \
    "https://github.com/BlueBubblesApp/bluebubbles-server/releases/download/v$_bb_version/$_bb_dmg"
  echo "$_bb_sha256  $_bb_tmp/$_bb_dmg" | shasum -a 256 -c -
  hdiutil attach -nobrowse -readonly -mountpoint "$_bb_tmp/mnt" "$_bb_tmp/$_bb_dmg" > /dev/null
  ditto "$_bb_tmp/mnt/BlueBubbles.app" "$BLUEBUBBLES_APP"
  hdiutil detach "$_bb_tmp/mnt" > /dev/null
  rm -rf "$_bb_tmp"
fi

###############################################################################
# Cleanup -- remove casks this Mac doesn't need                              #
###############################################################################

# The Mac is managed over SSH, so it keeps BlueBubbles plus a few apps for
# logging in at the box. Uninstall every other Homebrew-managed cask (e.g.
# google-chrome, slack). Apps installed outside Homebrew aren't listed by brew
# and are left alone. Re-running is a no-op. bluebubbles stays on the list for
# Macs where the old cask installed it; brew warns it's disabled but the app
# keeps working.
_keep_casks="alfred bluebubbles iterm2 rectangle"
for _cask in $(brew list --cask 2>/dev/null || true); do
  case " $_keep_casks " in
    *" $_cask "*) ;;
    *)
      echo "Uninstalling cask $_cask -- this Mac only runs BlueBubbles ..."
      brew uninstall --cask "$_cask"
      ;;
  esac
done

###############################################################################
# Cleanup -- remove the deploy-target setup this Mac briefly had             #
###############################################################################

# This Mac used to also be a Node app deploy target (mise, Postgres, Valkey /
# Redis). That moved off it: Homebrew builds everything from source on Intel,
# which made the extra services too brittle to keep here. Undo that setup.
# Every step checks before acting, so re-running is a no-op. Database data
# directories under $(brew --prefix)/var are left alone -- delete them by hand.
for _formula in $(brew list --formula 2>/dev/null | grep -E '^(postgresql(@[0-9]+)?|valkey|redis|mise)$' || true); do
  echo "Removing Homebrew $_formula -- this Mac only runs BlueBubbles ..."
  sudo brew services stop "$_formula" > /dev/null 2>&1 || true
  brew services stop "$_formula" > /dev/null 2>&1 || true
  brew uninstall --force "$_formula"
  _removed_formulae=1
done

# Drop dependencies nothing needs any more (only when something was removed,
# so a clean run doesn't prune formulae for unrelated reasons).
if [ -n "${_removed_formulae:-}" ]; then
  brew autoremove
fi

# mise installed from its prebuilt binary lands in ~/.local/bin; implode removes
# the binary plus every runtime it installed.
if [ -x "$HOME/.local/bin/mise" ]; then
  echo "Removing mise ..."
  "$HOME/.local/bin/mise" implode --yes
fi

# Take out the line earlier versions of this script added to activate mise.
# grep exits 1 when it filters out every line, which is still a success here.
ZPROFILE="$HOME/.zprofile.local"
# shellcheck disable=SC2016
if grep -qxF 'eval "$(mise activate zsh)"' "$ZPROFILE" 2>/dev/null; then
  echo "Removing mise activation from $ZPROFILE ..."
  grep -vxF 'eval "$(mise activate zsh)"' "$ZPROFILE" > "$ZPROFILE.tmp" || true
  mv "$ZPROFILE.tmp" "$ZPROFILE"
fi

###############################################################################
# SSH -- enable Remote Login for remote access                               #
###############################################################################

pgrep sshd > /dev/null 2>&1 || \
  sudo launchctl load -w /System/Library/LaunchDaemons/ssh.plist

###############################################################################
# Screen Sharing -- enable for remote desktop                                #
###############################################################################

nc -z localhost 5900 2>/dev/null || \
  sudo launchctl load -w /System/Library/LaunchDaemons/com.apple.screensharing.plist

###############################################################################
# Tailscale -- start daemon (run 'sudo tailscale up' to authenticate)       #
###############################################################################

# Only when Homebrew owns tailscale; otherwise whatever installed it runs it.
if [ -n "$_tailscale_brew" ]; then
  sudo brew services start tailscale
fi

###############################################################################
# Internet Sharing -- en2 (WiFi) to en0, en1 (Ethernet)                     #
###############################################################################

# com.apple.nat.plist is already configured -- just ensure the service is running
sudo launchctl load -w /System/Library/LaunchDaemons/com.apple.InternetSharing.plist 2>/dev/null || true

###############################################################################
# Power & Software Update -- lock down settings that cause silent downtime   #
###############################################################################

# Sleeping or a silent point-release both take a headless box offline with no
# one around to notice. Disable sleep outright (a headless box has no display
# to protect and no battery to save), enable wake-on-LAN as a safety net in
# case sleep is ever re-enabled, and auto-restart after a power interruption.
echo "Tuning pmset for unattended operation ..."
sudo pmset -a sleep 0 displaysleep 0 disksleep 0 powernap 0 womp 1 autorestart 1

# A background point update can silently strip root patches on OCLP-patched
# hardware and lock out remote access -- disable automatic checks/downloads so
# updates only happen when explicitly run by hand.
echo "Disabling automatic macOS software updates ..."
sudo softwareupdate --schedule off > /dev/null 2>&1 || true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool false
sudo defaults write /Library/Preferences/com.apple.commerce AutoUpdate -bool false

###############################################################################
# poke-messages -- keep Messages.app alive for BlueBubbles                  #
###############################################################################

# Messages.app can go idle on autonomous setups and miss incoming messages.
# This LaunchAgent pokes it every 5 minutes to keep it responsive.
POKE_SCRIPT="$HOME/Scripts/poke-messages.scpt"
POKE_PLIST="$HOME/Library/LaunchAgents/com.user.poke-messages.plist"

mkdir -p "$HOME/Scripts"
cat > "$POKE_SCRIPT" <<'SCPT'
tell application "Messages"
    launch
    count every chat
end tell
SCPT

mkdir -p "$HOME/Library/LaunchAgents"
cat > "$POKE_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.poke-messages</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/osascript</string>
        <string>$HOME/Scripts/poke-messages.scpt</string>
    </array>
</dict>
</plist>
EOF

# Idempotent load: unload if already running, then reload
launchctl bootout "gui/$(id -u)/com.user.poke-messages" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$POKE_PLIST"

###############################################################################
# health-check -- warn before hardware trouble takes the box down            #
###############################################################################

# Runs as root every 15 minutes (needs root for smartctl/powermetrics) and
# checks the things most likely to precede an unattended failure: a failing
# drive, a full disk, heavy swapping, an overheating CPU, a stalled fan, lost
# AC power (if a UPS is connected and macOS recognizes it), and whether
# BlueBubbles/Messages.app are still up. Every run appends one summary line
# to the log for trend-watching.
#
# A failing check texts you via BlueBubbles' own local REST API (it's already
# running on this Mac for the bridge itself, so this needs no third-party
# service): it calls http://localhost:1234/api/v1/message/text to send you an
# iMessage as if BlueBubbles were messaging you directly. Falls back to a push
# via ntfy.sh (https://ntfy.sh, no account needed) when that call fails --
# which also covers the case where BlueBubbles itself is the thing that's down
# and can't be used to report its own outage.
#
# Opt in by rerunning this script with:
#   BLUEBUBBLES_PASSWORD=<same password noted in TODO.md's REST API step> \
#   BLUEBUBBLES_ALERT_NUMBER=<your number in E.164, e.g. +15551234567, or an iCloud email> \
#     sh mac-bluebubbles
# Add HEALTH_NTFY_TOPIC=<a hard-to-guess topic> (anyone who knows it can read
# your alerts) for the ntfy.sh fallback. Any subset can be set on a given run --
# previously configured values are kept, not wiped. Without any of them,
# checks still run and log locally -- see TODO.md.
HEALTH_CONF="/etc/laptop-health.conf"

# Updates (or adds) one KEY=value line in $HEALTH_CONF, leaving every other
# line alone -- so setting one alert var on a later run doesn't erase another
# one set previously. A no-op when the value is empty.
_set_health_conf() {
  [ -n "$2" ] || return 0
  sudo touch "$HEALTH_CONF"
  sudo chmod 600 "$HEALTH_CONF"
  sudo sh -c "grep -vE '^$1=' '$HEALTH_CONF' 2>/dev/null > '$HEALTH_CONF.tmp'; printf '%s=%s\n' '$1' '$2' >> '$HEALTH_CONF.tmp'; mv '$HEALTH_CONF.tmp' '$HEALTH_CONF'"
}

_set_health_conf BLUEBUBBLES_PASSWORD "${BLUEBUBBLES_PASSWORD:-}"
_set_health_conf BLUEBUBBLES_ALERT_NUMBER "${BLUEBUBBLES_ALERT_NUMBER:-}"
_set_health_conf HEALTH_NTFY_TOPIC "${HEALTH_NTFY_TOPIC:-}"

if [ -n "${BLUEBUBBLES_PASSWORD:-}${BLUEBUBBLES_ALERT_NUMBER:-}${HEALTH_NTFY_TOPIC:-}" ]; then
  echo "Health-check alert config updated in $HEALTH_CONF."
elif [ ! -s "$HEALTH_CONF" ]; then
  echo "No health-check alert channel configured yet -- checks will log locally only (see TODO.md)."
fi

HEALTH_SCRIPT="$HOME/Scripts/health-check.sh"
mkdir -p "$HOME/Scripts"
cat > "$HEALTH_SCRIPT" <<'HEALTHSH'
#!/bin/zsh

# Homebrew's bin isn't on root's PATH by default (jq/smartctl come from brew).
if [ -d /opt/homebrew/bin ]; then
  PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
else
  PATH="/usr/local/bin:/usr/local/sbin:$PATH"
fi
export PATH

LOG="/var/log/laptop-health.log"
CONF="/etc/laptop-health.conf"
[ -f "$CONF" ] && . "$CONF"

alerts=""
add_alert() { alerts="$alerts
- $1"; }

# SMART health -- catches a drive failing before it takes the box down. Some
# older Apple SSDs don't expose SMART over their proprietary controller;
# treat "not supported" as informational rather than a fault.
for disk in $(diskutil list -plist | plutil -convert json -o - - 2>/dev/null | jq -r '.WholeDisks[]?' 2>/dev/null); do
  smart_out=$(smartctl -H "/dev/$disk" 2>&1)
  case "$smart_out" in
    *FAILED*) add_alert "SMART: /dev/$disk reports FAILED" ;;
  esac
done

# Disk space
disk_pct=$(df -P / | awk 'NR==2 { gsub("%","",$5); print $5 }')
[ -n "$disk_pct" ] && [ "$disk_pct" -ge 90 ] && add_alert "Disk: / is ${disk_pct}% full"

# Swap -- heavy sustained swapping on a 64GB box usually means something is
# leaking or misconfigured, and precedes the box grinding to a halt.
swap_used=$(sysctl -n vm.swapusage 2>/dev/null | grep -o 'used = [0-9.]*M' | grep -o '[0-9.]*')
if [ -n "$swap_used" ] && awk "BEGIN { exit !($swap_used > 8192) }"; then
  add_alert "Memory: swap usage is ${swap_used}MB"
fi

# Thermal -- catches the aging-paste failure mode (rising idle temps) and a
# dead/stalled fan before either causes a thermal shutdown.
smc_out=$(powermetrics -n 1 -i 1000 --samplers smc 2>/dev/null)
cpu_temp=$(echo "$smc_out" | grep -i "CPU die temperature" | grep -o '[0-9.]*' | head -1)
if [ -n "$cpu_temp" ] && awk "BEGIN { exit !($cpu_temp > 85) }"; then
  add_alert "Thermal: CPU die temperature is ${cpu_temp}C"
fi
fan_rpm=$(echo "$smc_out" | grep -i "Fan:" | grep -o '[0-9]*' | head -1)
[ -n "$fan_rpm" ] && [ "$fan_rpm" -eq 0 ] && add_alert "Thermal: fan reads 0 RPM"

# Power -- only fires if a UPS is connected and macOS recognizes it.
batt_line=$(pmset -g batt 2>/dev/null | head -1)
case "$batt_line" in
  *"UPS Power"*) add_alert "Power: running on UPS battery, AC power lost" ;;
esac

# Service liveness
pgrep -x BlueBubbles > /dev/null 2>&1 || add_alert "BlueBubbles is not running"
pgrep -x Messages > /dev/null 2>&1 || add_alert "Messages.app is not running"

alert_count=$(echo "$alerts" | grep -c '^- ')
printf '%s\tdisk=%s%%\tswap=%sMB\tcpu=%sC\tfan=%sRPM\talerts=%s\n' \
  "$(date '+%Y-%m-%dT%H:%M:%S%z')" "${disk_pct:-?}" "${swap_used:-0}" \
  "${cpu_temp:-?}" "${fan_rpm:-?}" "$alert_count" >> "$LOG"

# Text yourself via BlueBubbles' own local REST API first -- no third-party
# service needed for the common case. Falls back to ntfy.sh (if configured)
# when that call fails, which also covers BlueBubbles itself being down.
if [ -n "$alerts" ]; then
  msg="$(hostname):$alerts"
  sent=0
  if [ -n "${BLUEBUBBLES_PASSWORD:-}" ] && [ -n "${BLUEBUBBLES_ALERT_NUMBER:-}" ]; then
    chat_guid="iMessage;-;${BLUEBUBBLES_ALERT_NUMBER}"
    body=$(jq -n --arg guid "$chat_guid" --arg tmp "health-$(date +%s)" --arg msg "$msg" \
      '{chatGuid: $guid, tempGuid: $tmp, message: $msg, method: "apple-script"}')
    curl -fsS -m 10 -X POST "http://localhost:${BLUEBUBBLES_PORT:-1234}/api/v1/message/text?password=${BLUEBUBBLES_PASSWORD}" \
      -H 'Content-Type: application/json' -d "$body" > /dev/null 2>&1 && sent=1
  fi
  if [ "$sent" -eq 0 ] && [ -n "${HEALTH_NTFY_TOPIC:-}" ]; then
    curl -fsS -m 10 -H "Title: mac-bluebubbles health alert ($(hostname))" -H "Priority: high" \
      -d "$msg" "https://ntfy.sh/$HEALTH_NTFY_TOPIC" > /dev/null 2>&1
  fi
fi
HEALTHSH
chmod +x "$HEALTH_SCRIPT"

HEALTH_PLIST="/Library/LaunchDaemons/com.laptop.health-check.plist"
sudo tee "$HEALTH_PLIST" > /dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.laptop.health-check</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>$HEALTH_SCRIPT</string>
    </array>
</dict>
</plist>
EOF

# LaunchDaemons load into the system domain (not gui/<uid>) and run as root.
sudo launchctl bootout system/com.laptop.health-check 2>/dev/null || true
sudo launchctl bootstrap system "$HEALTH_PLIST"

###############################################################################
# zsh                                                                         #
###############################################################################

shell_path="$(command -v zsh)"
echo "Ensuring default shell is zsh at '$shell_path' ..."
if ! grep "$shell_path" /etc/shells > /dev/null 2>&1; then
  sudo sh -c "echo $shell_path >> /etc/shells"
fi
if [ "$SHELL" != "$shell_path" ]; then
  sudo chsh -s "$shell_path" "$USER"
fi

###############################################################################
# macOS defaults -- automation-friendly only                                 #
###############################################################################

echo "Configuring macOS defaults ..."

# Keep background processes alive
defaults write NSGlobalDomain NSDisableAutomaticTermination -bool true

# No iCloud document syncing
defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false

# Reveal IP address, hostname, OS version when clicking clock in login window
sudo defaults write /Library/Preferences/com.apple.loginwindow AdminHostInfo HostName

# Locale
defaults write NSGlobalDomain AppleLanguages -array "en"
defaults write NSGlobalDomain AppleLocale -string "en_US@currency=USD"
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false

# Require password immediately after screensaver
defaults write com.apple.screensaver askForPassword -int 1
defaults write com.apple.screensaver askForPasswordDelay -int 0

# No .DS_Store on network volumes
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true

# No confirmation dialogs that could block automation
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false
defaults write com.apple.finder WarnOnEmptyTrash -bool false

for app in "Dock" "Finder" "SystemUIServer"; do
  killall "$app" > /dev/null 2>&1 || true
done

echo "macOS defaults configured."

###############################################################################
# TODO.md -- manual steps with live status                                   #
###############################################################################

_ok() { sh -c "$1" > /dev/null 2>&1 && printf 'x' || printf ' '; }

_TS=$(_ok "tailscale status")
_BB=$(_ok "pgrep -x BlueBubbles")
_HEALTH_ALERTS=$(_ok "test -s '$HEALTH_CONF'")
_GENERATED=$(date '+%Y-%m-%d %H:%M:%S')
TODO_FILE="$HOME/TODO.md"

cat > "$TODO_FILE" <<EOF
# Mac BlueBubbles Setup

_Last updated: $_GENERATED — rerun mac-bluebubbles to refresh status._

- [$_TS] Authenticate Tailscale: \`sudo tailscale up\`
- [$_BB] Launch BlueBubbles, sign in with Apple ID, enable REST API (Settings → Server → enable REST API), note the server URL and password
- [ ] Approve Automation permission — macOS will prompt when osascript first accesses Messages.app; allow in System Settings → Privacy & Security → Automation
- [ ] Sign into iMessage — Messages.app → Settings → iMessage
- [ ] On the machine connecting to this bridge, supply the BlueBubbles server URL and password
- [$_HEALTH_ALERTS] Configure health-check alerts: rerun with \`BLUEBUBBLES_PASSWORD=... BLUEBUBBLES_ALERT_NUMBER=+1... sh mac-bluebubbles\` to text yourself via BlueBubbles (reuse the REST API password from the step above), optionally adding \`HEALTH_NTFY_TOPIC=your-topic-here\` as a fallback for when BlueBubbles itself is down. Or edit $HEALTH_CONF by hand. Without either, checks still log to /var/log/laptop-health.log every 15 minutes but nothing pages you.
EOF

###############################################################################
# Summary                                                                     #
###############################################################################

LOCAL_IP="$(ipconfig getifaddr en2 2>/dev/null || echo 'unknown')"

echo ""
echo "============================================================"
echo "Setup complete. This Mac is an iMessage bridge via BlueBubbles."
echo ""
echo "Local IP (WiFi):  $LOCAL_IP"
echo "SSH:              ssh $USER@$LOCAL_IP"
echo "Screen Sharing:   vnc://$LOCAL_IP"
echo ""
echo "Tailscale: daemon started -- run 'sudo tailscale up' to authenticate."
echo "After auth, SSH and Screen Sharing work from anywhere via Tailscale IP."
echo ""
if [ -s "$HEALTH_CONF" ]; then
  _HEALTH_SUMMARY="alerts configured -- see $HEALTH_CONF"
else
  _HEALTH_SUMMARY="log-only -- no alert channel configured, see TODO.md"
fi
echo "Health checks: every 15 min via LaunchDaemon (com.laptop.health-check)."
echo "  SMART, disk space, swap, CPU temp/fan, UPS power, service liveness."
echo "  Log: /var/log/laptop-health.log ($_HEALTH_SUMMARY)"
echo ""
echo "Manual steps: $TODO_FILE"
echo "============================================================"
